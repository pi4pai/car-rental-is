@startuml
hide circle
hide empty methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 130

class "Автопарк" as C1 {
  назва : String
  адреса : String
}
class "Автомобіль" as C2 {
  державний номер : String
  марка : String
  модель : String
  рік випуску : Integer
  пробіг : Integer
  статус : {доступний, заброньований, в оренді, на обслуговуванні}
}
class "Тарифний план" as C3 {
  назва : String
  вартість за добу : Money
  штраф за добу прострочення : Money
  дата початку дії : Date
}
class "Клієнт" as C4 {
  ПІБ : String
  телефон : String
  електронна пошта : String
  номер посвідчення водія : String
}
class "Бронювання" as C5 {
  номер : String
  дата початку : Date
  дата завершення : Date
  попередня вартість : Money
  статус : {активне, скасоване, завершене}
}
class "Оренда" as C6 {
  номер договору : String
  дата видачі : Date
  планова дата повернення : Date
  фактична дата повернення : Date
  остаточна вартість : Money
}
class "Працівник" as C7 {
  табельний номер : String
  ПІБ : String
  телефон : String
}
class "Менеджер" as C8 {
  пункт видачі : String
}
class "Адміністратор" as C9 {
  дата призначення : Date
}
class "Акт стану" as C10 {
  тип акта : {видача, повернення}
  дата складання : Date
  показник пробігу : Integer
  рівень пального : Integer
  опис пошкоджень : String
}
class "Платіж" as C11 {
  сума : Money
  дата : Date
  спосіб оплати : {готівка, банківська картка}
}

C1 "1" o-- "0..*" C2 : складається з >
C2 "0..*" -- "1" C3 : тарифікується за >
C4 "1" -- "0..*" C5 : бронює >
C5 "0..*" -- "1" C2 : стосується >
C4 "0..*" -- "0..*" C2 : орендує >
C7 <|-- C8
C7 <|-- C9
C8 "1" -- "0..*" C6 : оформлює >
C9 "1..*" -- "1" C1 : керує >
C9 "1..*" -- "0..*" C3 : керує >
C8 "1" -- "0..*" C10 : складає >
C6 "1" o-- "0..2" C10 : містить >
C6 "1" o-- "0..*" C11 : має >
(C4, C2) .. C6
@enduml
